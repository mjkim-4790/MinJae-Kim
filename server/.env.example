# 서버 환경 변수 (복사해서 server/.env 로 사용)
NODE_ENV=development
PORT=4000

# 쉼표로 구분. 비워두면 http://localhost:5173 만 허용한다.
# 같은 Wi-Fi 의 스마트폰에서 테스트할 때는 노트북 IP 를 추가: http://192.168.0.10:5173
CORS_ORIGINS=

# 운영 배포 전 반드시 별도 값으로 교체 (세션 쿠키 서명 키)
SESSION_SECRET=dev-only-insecure-secret-change-me

# 테스트 등에서 별도 DB 파일을 쓰고 싶을 때만 지정
DB_PATH=

# Shell 이 없는 배포 환경(예: Render 무료 티어)에서 최초 운영자 계정을 자동 생성하고
# 싶을 때만 지정. 둘 다 있고 해당 이메일 계정이 없을 때만 만든다. 로컬 개발에서는
# create-operator.mjs 를 직접 쓰면 되므로 보통 비워둔다.
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_NAME=
