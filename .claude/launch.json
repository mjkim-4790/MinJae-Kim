{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recreation-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "recreation-client-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "client"
      ],
      "env": {
        "HTTPS": "1"
      },
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
